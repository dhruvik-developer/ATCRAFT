# =============================================================================
# ATCRAFT MANUFACTURING ERP — Environment Template
# Copy to .env.development / .env.staging / .env.production and fill in.
# NEVER commit a populated .env file (see .gitignore).
# =============================================================================

# --- Application ---------------------------------------------------------
APP_ENV=development                 # development | staging | production
APP_NAME="Atcraft Manufacturing ERP"
APP_DEBUG=true                      # MUST be false in staging/production
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                      # true in staging/production (structured logs)

# --- Database (PostgreSQL — source of truth) -----------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=atcraft_erp
POSTGRES_USER=atcraft
POSTGRES_PASSWORD=change-me-in-real-environments
# Async driver for the app (SQLAlchemy 2.x + asyncpg)
DATABASE_URL=postgresql+asyncpg://atcraft:change-me-in-real-environments@localhost:5432/atcraft_erp
# Sync driver for Alembic migrations
DATABASE_SYNC_URL=postgresql+psycopg://atcraft:change-me-in-real-environments@localhost:5432/atcraft_erp
DB_POOL_SIZE=10                     # bounded pool — never one connection per request
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false
DB_STATEMENT_TIMEOUT_MS=30000       # server-side guard against runaway queries

# --- Redis (cache / queue — NOT the source of truth) ---------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_DB=0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_ENABLED=true

# --- Security ------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE-ME-generate-a-64-byte-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=12
PASSWORD_HASH_SCHEME=argon2
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10

# --- CORS ----------------------------------------------------------------
# Comma-separated. Never use "*" together with credentials in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# --- File storage --------------------------------------------------------
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

# --- Business defaults ---------------------------------------------------
DEFAULT_CURRENCY=INR
MONEY_DECIMAL_PLACES=2
QUANTITY_DECIMAL_PLACES=4
MRP_SYNC_THRESHOLD_DEMAND_LINES=50   # above this an MRP run goes to Celery

# --- Observability -------------------------------------------------------
OTEL_ENABLED=false
OTEL_SERVICE_NAME=atcraft-erp-api
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_METRICS_ENABLED=true
SENTRY_DSN=

# --- Frontend (Vite — only VITE_* is exposed to the browser) -------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME="Atcraft Manufacturing ERP"
# Where browser crash reports are posted. Empty disables reporting entirely,
# which is the default. The payload carries no tokens, no request bodies, no
# query strings and no user email - see apps/web/src/lib/error-reporting.ts.
VITE_ERROR_REPORT_URL=
# Stamped on every crash report so a stack trace can be tied to a deployment.
VITE_APP_RELEASE=dev
