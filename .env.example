# =============================================================================
# ATCRAFT MANUFACTURING ERP — Environment Template
# Copy to .env at the repository root for local development - the one file
# both pydantic-settings (apps/api/src/core/config.py) and Docker Compose read
# for the local stack; an optional apps/api/.env overrides it for the API
# alone, and Vite reads only the VITE_* keys. Staging/production: do NOT copy
# this file - run ./scripts/deploy.sh <main|dev> init, which writes
# deploy/<name>.env with freshly generated JWT_SECRET and
# CREDENTIAL_ENCRYPTION_KEY values (see ONE-BOX-RUNBOOK.md).
# NEVER commit a populated .env file (see .gitignore).
#
# Every key below is read by something: a Settings field in config.py, a
# ${VAR} in docker-compose*.yml, the test conftest, or Vite.
# apps/api/tests/unit/test_env_template.py fails when that stops being true.
# =============================================================================

# --- Application ---------------------------------------------------------
APP_ENV=development                 # development | staging | production
APP_NAME="Atcraft Manufacturing ERP"
APP_DEBUG=true                      # MUST be false in staging/production
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                      # true in staging/production (structured logs)

# --- Database (PostgreSQL — source of truth) -----------------------------
# 127.0.0.1, not localhost. The infrastructure containers publish on 127.0.0.1
# (docker-compose.dev.yml binds every port that way), and on a host where
# `localhost` resolves to ::1 first - Windows does - redis-py connects to the
# IPv6 address alone: it waits out `socket_connect_timeout`, retries, and fails
# after four seconds, so every cache call stalls and /health/ready reports Redis
# down while `redis-cli ping` answers instantly. asyncpg does fall back to IPv4,
# but the dead attempt still costs about two seconds - the whole readiness
# budget. Inside Docker the hosts are `postgres` and `redis`, which resolve to
# IPv4 only, so this applies to the host-side values alone.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=atcraft_erp
POSTGRES_USER=atcraft
POSTGRES_PASSWORD=change-me-in-real-environments
# Async driver for the app (SQLAlchemy 2.x + asyncpg)
DATABASE_URL=postgresql+asyncpg://atcraft:change-me-in-real-environments@127.0.0.1:5432/atcraft_erp
# Sync driver for Alembic migrations
DATABASE_SYNC_URL=postgresql+psycopg://atcraft:change-me-in-real-environments@127.0.0.1:5432/atcraft_erp
DB_POOL_SIZE=10                     # bounded pool — never one connection per request
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false
DB_STATEMENT_TIMEOUT_MS=30000       # server-side guard against runaway queries
# The integration suite (apps/api/tests/conftest.py) builds its schema in a
# separate database on the same server, never in POSTGRES_DB.
TEST_POSTGRES_DB=atcraft_erp_test

# --- Redis (cache / queue — NOT the source of truth) ---------------------
# REDIS_PORT is the host port the local Compose stack publishes; the URLs
# below are what the app and the worker connect to.
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
# How often the allocation top-up reserves newly arrived stock for short sales
# orders, in seconds (at least 60).
SO_TOPUP_INTERVAL_SECONDS=900
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_ENABLED=true

# --- Security ------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE-ME-generate-a-64-byte-random-secret
# Independent key for encrypted MFA credentials. Required in staging and
# production; never reuse JWT_SECRET.
CREDENTIAL_ENCRYPTION_KEY=CHANGE-ME-generate-a-different-64-byte-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Claims checked on every token. Each deployment overrides both in
# deploy/<name>.env so a token minted by one deployment is rejected by the
# other.
JWT_ISSUER=atcraft-erp
JWT_AUDIENCE=atcraft-erp-api
PASSWORD_MIN_LENGTH=12
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=4   # per-address sign-in budget, x5 over the 5-minute window (RateLimitPolicy.LOGIN_PER_IP); default 20 per 5 min
# Comma-separated hostnames only (no scheme/path). Deployed environments must
# list their public hostname; localhost/backend are added for internal probes.
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- CORS ----------------------------------------------------------------
# Comma-separated. Never use "*" together with credentials in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# --- Outbound email ------------------------------------------------------
# Local development may leave delivery disabled. Staging/production require
# EMAIL_PROVIDER=smtp and a real HTTPS PUBLIC_WEB_URL so password reset works.
EMAIL_PROVIDER=disabled             # disabled | smtp
PUBLIC_WEB_URL=http://localhost:5173
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME="Atcraft Manufacturing ERP"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls              # starttls | tls | none
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=15

# --- File storage --------------------------------------------------------
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

# --- Business defaults ---------------------------------------------------
DEFAULT_CURRENCY=INR
MONEY_DECIMAL_PLACES=2
QUANTITY_DECIMAL_PLACES=4
MRP_SYNC_THRESHOLD_DEMAND_LINES=50   # above this an MRP run goes to Celery

# --- Observability -------------------------------------------------------
OTEL_ENABLED=false
OTEL_SERVICE_NAME=atcraft-erp-api
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_METRICS_ENABLED=true
SENTRY_DSN=

# --- Frontend (Vite — only VITE_* is exposed to the browser) -------------
# Relative in every deployment (the deployment's own nginx routes /api/v1).
# The Vite dev server and `vite preview` proxy /api to VITE_API_PROXY_TARGET,
# so the browser stays on one origin in the inner development loop too.
VITE_API_BASE_URL=/api/v1
# Read by vite.config.ts for the dev server and `vite preview` only; never
# inlined into the bundle.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# Bind mounts on Windows/macOS do not deliver file-change events reliably;
# set true when hot reload stops noticing edits inside the dev container.
# Dev-server only, like VITE_API_PROXY_TARGET.
VITE_USE_POLLING=false
# Where browser crash reports are posted. Empty disables reporting entirely,
# which is the default. The payload carries no tokens, no request bodies, no
# query strings and no user email - see apps/web/src/lib/error-reporting.ts.
# A deployed endpoint must be same-origin unless its origin is added to the CSP.
VITE_ERROR_REPORT_URL=
# Stamped on every crash report so a stack trace can be tied to a deployment.
VITE_APP_RELEASE=dev

# Web Push: a registered browser is opt-in; no extra deployment secret required.
WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
WEB_PUSH_TTL_SECONDS=86400
WEB_PUSH_TIMEOUT_SECONDS=10
WEB_PUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,push.services.mozilla.com,notify.windows.com,web.push.apple.com,push.apple.com
