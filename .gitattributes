# Normalise to LF in the repository so a Windows checkout does not produce a
# diff on every file, and shell scripts stay executable inside Linux containers.
* text=auto eol=lf

*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.dump  binary

# Generated: keep out of diffs and language statistics.
package-lock.json  linguist-generated=true
apps/web/dist/**   linguist-generated=true
