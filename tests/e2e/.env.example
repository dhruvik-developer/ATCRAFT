# End-to-end test configuration.
#
# Copy to `.env` in this directory; `lib/env.mjs` loads it for the Playwright
# config, every spec and every sweep script. Variables already exported in the
# shell win over the file.

# Where the SPA and the API are served. `make dev` runs Vite on :5173 and the
# API on :8000; a production-style stack behind nginx serves both on one port.
E2E_BASE_URL=http://localhost:5173
E2E_API_URL=http://localhost:8000/api/v1

# The administrator the suite drives. Must match src.core.seed.DEFAULT_ADMIN_EMAIL
# and must not be a .local address - EmailStr refuses special-use TLDs.
E2E_ADMIN_EMAIL=admin@atcraft.example

# The password the suite signs in with. The seed never leaves the account in a
# state that can use it directly: `python -m src.core.seed` generates a password
# unless told one, and either way flags the account `must_change_password`, and
# the API refuses every business route until it is replaced with a *different*
# value. So seed with the bootstrap password below, and let the suite replace it
# with this one on its first run:
#
#     cd apps/api && python -m src.core.seed --admin-password "$E2E_BOOTSTRAP_PASSWORD"
#
# Both must satisfy the password policy (12+ characters, mixed classes). After
# the first run only E2E_ADMIN_PASSWORD is ever used again.
E2E_ADMIN_PASSWORD=ChangeMe!Atcraft2026
E2E_BOOTSTRAP_PASSWORD=Bootstrap!Atcraft2026

# Dedicated, bound portal accounts used by the full browser release checks.
# Setup creates these through /users if absent; it never resets existing users.
# First run python -m src.core.demo_data after the baseline seed. New accounts
# bind the populated DM-VEN-PACK vendor (PACKING scope) and DM-DLR-VASTU dealer.
# Setup verifies both portals' own order and invoice lists/details; empty
# fixtures fail. Existing identities are never rebound or given new passwords.
# Use only a disposable development/test database for the write-path suite.
E2E_VENDOR_EMAIL=e2e.vendor@atcraft.example
E2E_VENDOR_PASSWORD=Vendor-E2E!Atcraft2026
E2E_DEALER_EMAIL=e2e.dealer@atcraft.example
E2E_DEALER_PASSWORD=Dealer-E2E!Atcraft2026
