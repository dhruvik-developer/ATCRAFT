{
  "name": "@atcraft/e2e",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "npm run typecheck",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:readiness": "node scripts/ui-readiness-sweep.mjs",
    "handbook:check": "node --test lib/handbook.test.mjs lib/navigation.test.mjs lib/audiences.test.mjs lib/portal-fixtures.test.mjs lib/screen-registry.test.mjs && node scripts/capture-screens.mjs --check",
    "report": "playwright show-report playwright-report",
    "install:browsers": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "typescript": "5.9.3"
  }
}
