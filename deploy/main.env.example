# =============================================================================
# DEPLOYMENT 1 - "main"  (the main branch; the client's environment)
#
#   cp deploy/main.env.example deploy/main.env      # then fill the secrets, or
#   ./scripts/deploy.sh main init                   # which generates them
#
# deploy/main.env is gitignored and must stay that way. Everything in this
# file is read by docker compose interpolation, so a name here has to match the
# variable used in docker-compose.yml exactly.
#
# The values that MUST differ from deploy/dev.env are marked (UNIQUE). Sharing
# any of them silently un-does the isolation this architecture exists for.
# =============================================================================

# --- Identity ----------------------------------------------------------------
# (UNIQUE) The isolation boundary. This one string decides which containers,
# which network and which volumes this deployment owns. Two deployments with
# the same project name are ONE deployment sharing a database, and the stack
# comes up perfectly while doing it.
COMPOSE_PROJECT_NAME=atcraft-main

# The git branch this deployment tracks. scripts/deploy.sh refuses to deploy
# from any other branch, so "I was on dev when I ran the deploy" cannot ship
# the wrong code to the client.
DEPLOY_BRANCH=main

# (UNIQUE) The loopback port the host nginx proxies to. Must match the
# proxy_pass in infrastructure/nginx/host/atcraft-main.conf.
HTTP_PORT=8081

# --- Application -------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO

# The browser origin this deployment answers on. Not a wildcard, and not the
# other deployment's hostname: with credentials allowed, "*" is an open door.
CORS_ORIGINS=https://erp.example.com
ALLOWED_HOSTS=erp.example.com

# --- Outbound email ----------------------------------------------------------
# Required: production refuses to start without working mail configuration,
# because password-reset responses must correspond to a deliverable link.
EMAIL_PROVIDER=smtp
PUBLIC_WEB_URL=https://erp.example.com
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME="Atcraft Manufacturing ERP"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=15

# --- Database ----------------------------------------------------------------
# The database NAME may match the other deployment's - they are in different
# clusters, in different containers, on different volumes, and neither can
# resolve the other's hostname. The PASSWORD may not.
POSTGRES_DB=atcraft_erp
POSTGRES_USER=atcraft
# (UNIQUE) Generate with:  openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Security ----------------------------------------------------------------
# (UNIQUE) Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# A shared JWT_SECRET means a token minted by the dev deployment authenticates
# against the client's production data. This is the single most important
# unique value in the file.
JWT_SECRET=
# (UNIQUE) Encrypts long-lived credentials such as TOTP seeds. Keep it
# independent from JWT_SECRET so signing-key rotation does not disable MFA.
CREDENTIAL_ENCRYPTION_KEY=
# Stamped into every token and checked on the way back in, so a token from the
# other deployment is rejected as wrong-audience rather than merely failing to
# verify - which is the difference between a clear 401 and a confusing one.
JWT_ISSUER=atcraft-erp-main
JWT_AUDIENCE=atcraft-erp-main

# --- Images ------------------------------------------------------------------
IMAGE_PREFIX=atcraft
# deploy.sh derives IMAGE_TAG from the exact Git commit and stamps it into the
# image and frontend bundle. It overrides any process/env-file value.

# Where browser crash reports are posted. Empty disables reporting, which is
# the default; the payload carries no tokens, bodies, query strings or emails.
# Keep this same-origin unless the deployment CSP is deliberately extended.
VITE_ERROR_REPORT_URL=

# Optional backend exception reporting. Empty disables it. The SDK strips
# request data, breadcrumbs, local variables and performance traces.
SENTRY_DSN=

# --- Resource sizing ---------------------------------------------------------
# Two Postgres clusters share one box's RAM. These are the numbers to change
# when the box is resized - and the reason nothing is hardcoded in the compose
# files. Rule of thumb: shared_buffers at 25% of what this deployment is
# allowed, effective_cache_size at 50-75% of it.
# Connections and memory have to be reconciled, and were not. Each gunicorn
# worker and each Celery child builds its own SQLAlchemy pool, so the demand is
#   GUNICORN_WORKERS x (DB_POOL_SIZE + DB_MAX_OVERFLOW)      4 x 20 =  80
# + CELERY_CONCURRENCY x (WORKER_DB_POOL_SIZE + overflow)    4 x 10 =  40
# + celery-beat                                              1 x  2 =   2
#                                                                     ---
#                                                                     122
# and work_mem is charged per sort node, so the pathological case is
# max_connections x work_mem, which must still leave room for shared_buffers
# inside PG_MEM_LIMIT:   150 x 8MB + 1GB = 2.2G, against a 4G limit.
# Raise max_connections and you must lower work_mem, or the box swaps.
PG_MAX_CONNECTIONS=150
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=256MB
PG_LOG_MIN_DURATION_MS=500
PG_MEM_LIMIT=4G

REDIS_MAXMEMORY=1gb
REDIS_MEM_LIMIT=1500M

GUNICORN_WORKERS=4
BACKEND_MEM_LIMIT=2G
CELERY_CONCURRENCY=4
WORKER_MEM_LIMIT=2G

# --- CPU ceilings ------------------------------------------------------------
# A limit, not a reservation: a container may use less, never more. Memory was
# already capped and CPU was not, so on a box running both deployments the
# busier one could take every core and starve the other - which is the one
# thing this whole two-deployment architecture exists to prevent.
#
# These are deployment 1's share. Keep the sum of BOTH deployments' ceilings
# at or below the box's core count if you want hard isolation; above it, they
# compete but neither can monopolise.
PG_CPU_LIMIT=1.5
REDIS_CPU_LIMIT=0.5
BACKEND_CPU_LIMIT=2
WORKER_CPU_LIMIT=1
BEAT_CPU_LIMIT=0.25
BEAT_MEM_LIMIT=256M
FRONTEND_CPU_LIMIT=0.5
FRONTEND_MEM_LIMIT=128M
EDGE_CPU_LIMIT=1
EDGE_MEM_LIMIT=256M

# Notifications run on their own worker so a password-reset e-mail never
# queues behind a ten-minute MRP plan. Small on purpose: the tasks are short.
NOTIFY_CONCURRENCY=2
NOTIFY_DB_POOL_SIZE=2
NOTIFY_DB_MAX_OVERFLOW=2
NOTIFY_CPU_LIMIT=0.5
NOTIFY_MEM_LIMIT=512M

# Storage shape. The defaults assume the NVMe a modern VPS actually has; on a
# spinning disk or a throttled network volume set PG_RANDOM_PAGE_COST=4 and
# PG_EFFECTIVE_IO_CONCURRENCY=1 to get the old, pessimistic cost model back.
PG_RANDOM_PAGE_COST=1.1
PG_EFFECTIVE_IO_CONCURRENCY=200
# Per-block I/O timing, which is what makes pg_stat_statements able to say
# whether a slow query was waiting on disk. Turn off only if pg_test_timing
# reports an expensive clocksource on this host.
PG_TRACK_IO_TIMING=on

# --- Connection pools -------------------------------------------------------
# The multiplicands in the arithmetic above. They are referenced by
# docker-compose.yml and the prod overlay, so without them here the numbers in
# that sum are values nobody can see or change from this file.
#
# Each is per *process*: an api container running 4 gunicorn workers opens
# up to 4 x (DB_POOL_SIZE + DB_MAX_OVERFLOW) connections, and the same shape
# applies to each celery worker. Raising one without redoing the sum against
# PG_MAX_CONNECTIONS is how a deployment runs out of connections under load
# rather than under test.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# The batch worker (default, mrp, reports queues). Smaller than the API's: a
# Celery task holds one session for its whole run, so concurrency bounds it.
WORKER_DB_POOL_SIZE=5
WORKER_DB_MAX_OVERFLOW=5
