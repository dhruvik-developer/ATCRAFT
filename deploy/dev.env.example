# =============================================================================
# DEPLOYMENT 2 - "dev"  (the dev branch; integration testing)
#
#   cp deploy/dev.env.example deploy/dev.env        # then fill the secrets, or
#   ./scripts/deploy.sh dev init                    # which generates them
#
# Deliberately the same shape as deploy/main.env.example. Read the two side by
# side: everything marked (UNIQUE) differs, and nothing else does. A setting
# that drifts between them is a difference between the two deployments that no
# test will notice - which defeats the purpose of having a dev deployment.
#
# This is a smaller deployment, not a laxer one. APP_DEBUG stays false (the
# prod overlay pins it), rate limiting stays on, and the database password is
# its own. A dev environment with production's conveniences removed but
# production's protections removed too tests nothing.
# =============================================================================

# --- Identity ----------------------------------------------------------------
# (UNIQUE) See main.env.example: this string IS the isolation boundary.
COMPOSE_PROJECT_NAME=atcraft-dev

DEPLOY_BRANCH=dev

# (UNIQUE) Must match the proxy_pass in
# infrastructure/nginx/host/atcraft-dev.conf.
HTTP_PORT=8082

# --- Application -------------------------------------------------------------
# `staging` rather than `development`: this is a deployed environment reached
# over the internet, so it gets deployed-environment behaviour. APP_DEBUG is
# forced false by docker-compose.prod.yml either way - a debug-enabled app
# returns stack traces to the browser, and a dev URL is still a public URL.
APP_ENV=staging
LOG_LEVEL=DEBUG

CORS_ORIGINS=https://dev.erp.example.com
ALLOWED_HOSTS=dev.erp.example.com

# --- Outbound email ----------------------------------------------------------
# Staging uses a sandbox/test SMTP account, never the client's production
# relay. The app refuses to start with delivery disabled in deployed modes.
EMAIL_PROVIDER=smtp
PUBLIC_WEB_URL=https://dev.erp.example.com
EMAIL_FROM_ADDRESS=no-reply-dev@example.com
EMAIL_FROM_NAME="Atcraft Manufacturing ERP (Dev)"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=15

# --- Database ----------------------------------------------------------------
POSTGRES_DB=atcraft_erp
POSTGRES_USER=atcraft
# (UNIQUE) Generate with:  openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Security ----------------------------------------------------------------
# (UNIQUE) Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Reusing main's secret here would mean a token issued by this deployment - the
# one people experiment in - authenticates against the client's live data.
JWT_SECRET=
# (UNIQUE) Long-lived credential encryption; must differ from JWT_SECRET and
# from the main deployment's value.
CREDENTIAL_ENCRYPTION_KEY=
JWT_ISSUER=atcraft-erp-dev
JWT_AUDIENCE=atcraft-erp-dev

# --- Images ------------------------------------------------------------------
IMAGE_PREFIX=atcraft
# deploy.sh derives IMAGE_TAG from the exact Git commit and stamps it into the
# image and frontend bundle. It overrides any process/env-file value.

# Keep this same-origin unless the deployment CSP is deliberately extended.
VITE_ERROR_REPORT_URL=

# Optional backend exception reporting. Use a non-production project here.
SENTRY_DSN=

# --- Resource sizing ---------------------------------------------------------
# Roughly a quarter of deployment 1. Both Postgres clusters run on one box, and
# whatever this one claims is unavailable to the client's deployment.
PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=768MB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=64MB
# Lower than main's 500ms: a dev deployment is where a slow query should be
# noticed, and the log volume does not matter here.
PG_LOG_MIN_DURATION_MS=200
PG_MEM_LIMIT=1G

REDIS_MAXMEMORY=256mb
REDIS_MEM_LIMIT=384M

GUNICORN_WORKERS=2
BACKEND_MEM_LIMIT=1G
CELERY_CONCURRENCY=2
WORKER_MEM_LIMIT=1G
