# =============================================================================
# DEPLOYMENT 2 - "dev"  (the dev branch; integration testing)
# `dev` is the guarded deployment branch. Current development integrates on
# `develop`; promote that tested revision to `dev` before using this deployment.
#
#   cp deploy/dev.env.example deploy/dev.env        # then fill the secrets, or
#   ./scripts/deploy.sh dev init                    # which generates them
#
# Deliberately the same shape as deploy/main.env.example. Read the two side by
# side: everything marked (UNIQUE) differs, and nothing else does. A setting
# that drifts between them is a difference between the two deployments that no
# test will notice - which defeats the purpose of having a dev deployment.
#
# This is a smaller deployment, not a laxer one. APP_DEBUG stays false (the
# prod overlay pins it), rate limiting stays on, and the database password is
# its own. A dev environment with production's conveniences removed but
# production's protections removed too tests nothing.
# =============================================================================

# --- Identity ----------------------------------------------------------------
# (UNIQUE) See main.env.example: this string IS the isolation boundary.
COMPOSE_PROJECT_NAME=atcraft-dev

DEPLOY_BRANCH=dev

# (UNIQUE) Must match the proxy_pass in
# infrastructure/nginx/host/atcraft-dev.conf.
HTTP_PORT=8082

# --- Application -------------------------------------------------------------
# `staging` rather than `development`: this is a deployed environment reached
# over the internet, so it gets deployed-environment behaviour. APP_DEBUG is
# forced false by docker-compose.prod.yml either way - a debug-enabled app
# returns stack traces to the browser, and a dev URL is still a public URL.
APP_ENV=staging
LOG_LEVEL=DEBUG

CORS_ORIGINS=https://dev.erp.example.com
ALLOWED_HOSTS=dev.erp.example.com

# --- Outbound email ----------------------------------------------------------
# Staging uses a sandbox/test SMTP account, never the client's production
# relay. The app refuses to start with delivery disabled in deployed modes.
EMAIL_PROVIDER=smtp
PUBLIC_WEB_URL=https://dev.erp.example.com
EMAIL_FROM_ADDRESS=no-reply-dev@example.com
EMAIL_FROM_NAME="Atcraft Manufacturing ERP (Dev)"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=15

# --- Database ----------------------------------------------------------------
POSTGRES_DB=atcraft_erp
POSTGRES_USER=atcraft
# (UNIQUE) Generate with:  openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Security ----------------------------------------------------------------
# (UNIQUE) Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Reusing main's secret here would mean a token issued by this deployment - the
# one people experiment in - authenticates against the client's live data.
JWT_SECRET=
# (UNIQUE) Long-lived credential encryption; must differ from JWT_SECRET and
# from the main deployment's value.
CREDENTIAL_ENCRYPTION_KEY=
JWT_ISSUER=atcraft-erp-dev
JWT_AUDIENCE=atcraft-erp-dev

# --- Images ------------------------------------------------------------------
IMAGE_PREFIX=atcraft
# deploy.sh derives IMAGE_TAG from the exact Git commit and stamps it into the
# image and frontend bundle. It overrides any process/env-file value.

# Keep this same-origin unless the deployment CSP is deliberately extended.
VITE_ERROR_REPORT_URL=

# Optional backend exception reporting. Use a non-production project here.
SENTRY_DSN=

# Optional browser push. Delivery stays disabled until explicitly enabled.
# VAPID defaults to a purpose-separated derivation of CREDENTIAL_ENCRYPTION_KEY.
# Set an explicit key when VAPID identity must be managed independently.
WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_PRIVATE_KEY=
# Required when enabled/deployed unless EMAIL_FROM_ADDRESS supplies the contact.
WEB_PUSH_SUBJECT=
WEB_PUSH_TTL_SECONDS=86400
WEB_PUSH_TIMEOUT_SECONDS=10
WEB_PUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,push.services.mozilla.com,notify.windows.com,web.push.apple.com,push.apple.com

# --- Resource sizing ---------------------------------------------------------
# Roughly a quarter of deployment 1. Both Postgres clusters run on one box, and
# whatever this one claims is unavailable to the client's deployment.
# Deployment 2's demand is half deployment 1's (2 workers, concurrency 2):
#   2 x 20 + 2 x 10 + 1 x 4 (notifications) + 2 (beat) = 66 connections.
# 80 x 4MB + 256MB = 0.6G against the 1G limit. The previous 100 x 8MB + 256MB
# came to 1.03G - over the limit before a single query ran.
PG_MAX_CONNECTIONS=80
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=768MB
PG_WORK_MEM=4MB
PG_MAINTENANCE_WORK_MEM=64MB
# Lower than main's 500ms: a dev deployment is where a slow query should be
# noticed, and the log volume does not matter here.
PG_LOG_MIN_DURATION_MS=200
PG_MEM_LIMIT=1G

REDIS_MAXMEMORY=256mb
REDIS_MEM_LIMIT=384M

GUNICORN_WORKERS=2
BACKEND_MEM_LIMIT=1G
CELERY_CONCURRENCY=2
WORKER_MEM_LIMIT=1G

# --- CPU ceilings ------------------------------------------------------------
# Deployment 2 is the integration environment and is sized below deployment 1
# on purpose: when the box is busy, the client's environment should win. See
# deploy/main.env.example for what these mean.
PG_CPU_LIMIT=0.75
REDIS_CPU_LIMIT=0.25
BACKEND_CPU_LIMIT=1
WORKER_CPU_LIMIT=0.5
BEAT_CPU_LIMIT=0.25
BEAT_MEM_LIMIT=256M
FRONTEND_CPU_LIMIT=0.25
FRONTEND_MEM_LIMIT=128M
EDGE_CPU_LIMIT=0.5
EDGE_MEM_LIMIT=128M

# Notifications run on their own worker so a password-reset e-mail never
# queues behind a ten-minute MRP plan. Small on purpose: the tasks are short.
NOTIFY_CONCURRENCY=1
NOTIFY_DB_POOL_SIZE=2
NOTIFY_DB_MAX_OVERFLOW=2
NOTIFY_CPU_LIMIT=0.25
NOTIFY_MEM_LIMIT=256M

# Storage shape. The defaults assume the NVMe a modern VPS actually has; on a
# spinning disk or a throttled network volume set PG_RANDOM_PAGE_COST=4 and
# PG_EFFECTIVE_IO_CONCURRENCY=1 to get the old, pessimistic cost model back.
PG_RANDOM_PAGE_COST=1.1
PG_EFFECTIVE_IO_CONCURRENCY=200
# Per-block I/O timing, which is what makes pg_stat_statements able to say
# whether a slow query was waiting on disk. Turn off only if pg_test_timing
# reports an expensive clocksource on this host.
PG_TRACK_IO_TIMING=on

# --- Connection pools -------------------------------------------------------
# The multiplicands in the arithmetic above. They are referenced by
# docker-compose.yml and the prod overlay, so without them here the numbers in
# that sum are values nobody can see or change from this file.
#
# Each is per *process*: an api container running 2 gunicorn workers opens
# up to 2 x (DB_POOL_SIZE + DB_MAX_OVERFLOW) connections, and the same shape
# applies to each celery worker. Raising one without redoing the sum against
# PG_MAX_CONNECTIONS is how a deployment runs out of connections under load
# rather than under test.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# The batch worker (default, mrp, reports queues). Smaller than the API's: a
# Celery task holds one session for its whole run, so concurrency bounds it.
WORKER_DB_POOL_SIZE=5
WORKER_DB_MAX_OVERFLOW=5
