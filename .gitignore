# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
dist/
build/
*.egg-info/

# --- Node / Frontend ---
node_modules/
.vite/
apps/web/dist/
apps/web/.eslintcache
*.tsbuildinfo

# --- Environments (NEVER commit real secrets) ---
.env
.env.local
.env.development
.env.staging
.env.production
!.env.example

# --- Storage (runtime artefacts, not source) ---
storage/**
!storage/**/.gitkeep
# The API also defaults to an app-local storage directory when it is run from
# apps/api. Runtime documents must never enter source control from either
# launch location.
apps/api/storage/**
!apps/api/storage/**/.gitkeep

# --- Tooling / OS ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.log
logs/

# --- Test artefacts ---
tests/e2e/test-results/
tests/e2e/playwright-report/
playwright/.cache/

# --- Deployment env files (one per deployment, real secrets, NEVER committed)
# The .example templates are committed; the populated files are not. Each
# deployment gets its own generated secrets - see scripts/deploy.sh init.
deploy/*.env
!deploy/*.env.example
deploy/.locks/

# --- Database dumps -------------------------------------------------------
# A dump is a full copy of the business, including every hashed password.
# It must not reach a git remote, and a backup kept only on the box it was
# taken from is not a backup (section 45).
backups/
*.dump
*.sql.gz

# --- TLS material ---------------------------------------------------------
# Certificates now live on the host (/etc/letsencrypt); this directory is kept
# only for a self-signed pair used in local testing.
infrastructure/nginx/certs/*
!infrastructure/nginx/certs/.gitignore

# The handbook's outputs, not its sources. `content.json` is the writing and is
# committed; the PDF (16 MB), the 21 MB of screenshots and the base64 HTML
# intermediate are all regenerated by the two scripts in tests/e2e/scripts and
# would otherwise sit in history for ever. The repository refuses files over
# 1 MB on purpose - see the check-added-large-files hook - and a client
# deliverable is not a reason to make an exception.
docs/handbook/handbook.html
docs/handbook/Atcraft-ERP-Handbook.pdf
docs/handbook/screens/
.opencode/
tmp/
docs/implementation/reports/
*.pdf
AGENTS.md.txt
